# parser-service environment variables
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.

# Port our wrapper listens on.
# Use 9001 to avoid conflicting with the official SysML backend on 9000.
# Update VS Code setting sysmlVisualizer.parserServiceUrl to match.
PARSER_SERVICE_PORT=9001

# Base URL of the SysML v2 Pilot Implementation (the textual parser).
# NOTE: SysML-v2-API-Services is a model-storage service and has no parse
# endpoint — do not point this variable at it.  Use the Pilot Implementation.
# See docs/OFFICIAL_BACKEND_OPTIONS.md for setup instructions.
# Leave unset to use the "not connected" stub (default).
OFFICIAL_SYSML_BACKEND_URL=http://localhost:9000

# Path on the Pilot Implementation to probe for liveness.
OFFICIAL_SYSML_HEALTH_PATH=/health

# Path on the Pilot Implementation to send parse requests to.
# Confirm the exact path from the Pilot Implementation's Swagger UI, then
# update this value and docs/OFFICIAL_BACKEND_ENDPOINT_MAPPING.md.
OFFICIAL_SYSML_PARSE_PATH=/parse
