{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020"],
    "types": ["node"],
    "outDir": "./out-extension",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src-vscode"],
  "files": [
    "parser-service/src/types.ts",
    "parser-service/src/javaWrapperClient.ts",
    "parser-service/src/graphBuilder.ts",
    "parser-service/src/behaviorBuilder.ts"
  ],
  "exclude": ["node_modules", ".vscode-test"]
}
