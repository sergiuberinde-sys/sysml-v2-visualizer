{
  "name": "sysml-v2-visualizer",
  "displayName": "SysML v2 Visualizer",
  "description": "Visualizer for SysML v2 models",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out-extension/src-vscode/extension.js",
  "activationEvents": [
    "onLanguage:sysml",
    "onCommand:sysmlVisualizer.openVisualizer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sysml",
        "extensions": [
          ".sysml"
        ],
        "aliases": [
          "SysML",
          "sysml"
        ]
      }
    ],
    "commands": [
      {
        "command": "sysmlVisualizer.openVisualizer",
        "title": "Open SysML v2 Visualizer"
      },
      {
        "command": "sysmlVisualizer.debugDiagnostics",
        "title": "SysML: Debug Diagnostics"
      },
      {
        "command": "sysmlVisualizer.revealModelSource",
        "title": "SysML: Reveal Current Model Source"
      },
      {
        "command": "sysmlVisualizer.debugSemanticTokens",
        "title": "SysML: Debug Semantic Tokens"
      }
    ],
    "configuration": {
      "title": "SysML v2 Visualizer",
      "properties": {
        "sysmlVisualizer.parserServiceUrl": {
          "type": "string",
          "default": "http://localhost:9001",
          "markdownDescription": "URL of the official SysML v2 parser service. Used when **Official SysML v2** mode is selected in the visualizer tab bar.\n\nThe service must implement `POST /parse` and `GET /health`. See `parser-service/README.md` for setup instructions.",
          "scope": "window",
          "order": 1
        },
        "sysmlVisualizer.officialParserMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When enabled, VS Code Problems panel diagnostics are sourced from the official SysML v2 parser service (`parserServiceUrl`) instead of the built-in prototype parser.\n\nRequires the parser service to be running. See `parser-service/README.md`.",
          "scope": "window",
          "order": 2
        }
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run && npm --prefix parser-service test",
    "test:watch": "vitest",
    "compile:extension": "tsc -p tsconfig.extension.json && node scripts/write-extension-pkg.cjs",
    "watch:extension": "tsc -p tsconfig.extension.json --watch",
    "package:extension": "vsce package",
    "parser:dev": "npm --prefix parser-service install && npm --prefix parser-service run dev",
    "parser:build": "npm --prefix parser-service install && npm --prefix parser-service run build",
    "parser:start": "npm --prefix parser-service run start"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.2",
    "elkjs": "^0.11.1",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.118.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
