{
  "name": "sysml-v2-visualizer",
  "displayName": "SysML v2 Visualizer",
  "description": "Visualizer for SysML v2 models",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "vscode": "^1.71.0"
  },
  "main": "./out-extension/src-vscode/extension.js",
  "activationEvents": [
    "onLanguage:sysml",
    "onCommand:sysmlVisualizer.openVisualizer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sysml",
        "extensions": [
          ".sysml"
        ],
        "aliases": [
          "SysML",
          "sysml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sysml",
        "scopeName": "source.sysml",
        "path": "./syntaxes/sysml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sysmlVisualizer.openVisualizer",
        "title": "Open SysML v2 Visualizer"
      },
      {
        "command": "sysmlVisualizer.debugDiagnostics",
        "title": "SysML: Debug Diagnostics"
      },
      {
        "command": "sysmlVisualizer.revealModelSource",
        "title": "SysML: Reveal Current Model Source"
      },
      {
        "command": "sysmlVisualizer.debugSemanticTokens",
        "title": "SysML: Debug Semantic Tokens"
      },
      {
        "command": "sysmlVisualizer.revealTrlcReq",
        "title": "SysML: View Requirement in Trace"
      }
    ],
    "configuration": {
      "title": "SysML v2 Visualizer",
      "properties": {
        "sysmlVisualizer.parserServiceUrl": {
          "type": "string",
          "default": "http://localhost:9001",
          "markdownDescription": "URL of the SysML v2 parser service. The service must implement `POST /parse` and `GET /health`. See `parser-service/README.md` for setup instructions.",
          "scope": "window",
          "order": 1
        }
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run && npm --prefix parser-service test",
    "test:watch": "vitest",
    "compile:extension": "tsc -p tsconfig.extension.json && node scripts/write-extension-pkg.cjs",
    "dev:launch": "npm run build && npm run compile:extension",
    "watch:extension": "tsc -p tsconfig.extension.json --watch",
    "package:extension": "vsce package",
    "parser:dev": "npm --prefix parser-service install && npm --prefix parser-service run dev",
    "parser:build": "npm --prefix parser-service install && npm --prefix parser-service run build",
    "parser:start": "npm --prefix parser-service run start"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.2",
    "elkjs": "^0.11.1",
    "html-to-image": "^1.11.13",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.71.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
