{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (demo project)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/demo-projects/AcpdCdd_SysMLv2_Integrated_Project_Full"
      ],
      "outFiles": ["${workspaceFolder}/out-extension/**/*.js"],
      "preLaunchTask": "npm: dev:launch"
    },
    {
      "name": "Run Extension (empty window)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out-extension/**/*.js"],
      "preLaunchTask": "npm: dev:launch"
    }
  ]
}